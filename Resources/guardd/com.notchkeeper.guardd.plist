<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  guardd 的每用户 LaunchAgent（以登录用户身份跑，不要 root）。
  这是模板：两个占位符（二进制路径、日志路径）由 scripts/install-guardd.sh 换成绝对路径（launchd 不展开 ~）。
  KeepAlive.SuccessfulExit=false：崩溃或非 0 退出才重启；SIGTERM 后 guardd exit 0，不会被拉起。
  @see man launchd.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.notchkeeper.guardd</string>
	<key>ProgramArguments</key>
	<array>
		<string>__GUARDD_PATH__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__LOG_PATH__</string>
	<key>StandardErrorPath</key>
	<string>__LOG_PATH__</string>
</dict>
</plist>
