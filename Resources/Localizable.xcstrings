    "找不到 App，可能被移动过。关掉再打开一次即可。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't find the app; it may have been moved. Turn this off and on again."
          }
        }
      }
    },
    "找不到 claude": {
